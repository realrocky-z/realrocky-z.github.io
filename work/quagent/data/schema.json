{
 "scenario": {
  "title": "海外外卖平台反作弊取数场景",
  "business": "覆盖新加坡、曼谷、吉隆坡、雅加达、胡志明市、马尼拉六个城市的外卖订单、用户行为、设备、骑手、商家与优惠券数据。用于练习异常交易识别、作弊特征分析、策略前后对比与监控指标取数。",
  "data_range": [
   "2026-10-05 00:00:00",
   "2026-11-01 23:59:59"
  ],
  "reference_date": "2026-11-01",
  "timezone": "UTC",
  "currency": "美元等值",
  "disclaimer": "全部为合成数据，不含任何真实公司、用户或交易信息。"
 },
 "tables": {
  "users": {
   "grain": "一行一个注册账号",
   "columns": {
