    },
    "last_seen_ts": {
     "type": "TEXT",
     "desc": "该账号最后一次在此设备活跃的时间"
    },
    "ip_city": {
     "type": "TEXT",
     "desc": "设备最近 IP 归属城市"
    }
   }
  },
  "riders": {
   "grain": "一行一个骑手",
   "columns": {
    "rider_id": {
     "type": "TEXT",
     "desc": "骑手 ID，R 开头"
    },
    "city": {
     "type": "TEXT",
     "desc": "骑手所属城市"
    },
    "signup_ts": {
     "type": "TEXT",
     "desc": "骑手注册时间"
    },
    "status": {
     "type": "TEXT",
     "desc": "在职状态：active/inactive"
    },
    "device_id": {
     "type": "TEXT",
     "desc": "骑手本人常用设备 ID，可能为空"
    }
   }
  },
  "merchants": {
   "grain": "一行一个商家",
   "columns": {
    "merchant_id": {
     "type": "TEXT",
     "desc": "商家 ID，M 开头"
    },
    "city": {
     "type": "TEXT",
     "desc": "商家所在城市"
    },
    "category": {
     "type": "TEXT",
     "desc": "品类：快餐/饮品/甜品/正餐/超市"
    },
    "signup_ts": {
     "type": "TEXT",
     "desc": "入驻时间"
    }
   }
  },
  "orders": {
   "grain": "一行一个订单",
   "columns": {
    "order_id": {
     "type": "TEXT",
     "desc": "订单 ID，O 开头"
    },
    "user_id": {
     "type": "TEXT",
     "desc": "下单账号"
    },
    "rider_id": {
     "type": "TEXT",
     "desc": "配送骑手；未接单时可为空"
    },
    "merchant_id": {
     "type": "TEXT",
     "desc": "商家"
    },
    "city": {
     "type": "TEXT",
     "desc": "下单城市"
    },
    "order_ts": {
     "type": "TEXT",
     "desc": "下单时间，UTC"
