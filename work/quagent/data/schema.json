     "desc": "券 ID，C 开头"
    },
    "user_id": {
     "type": "TEXT",
     "desc": "领券账号"
    },
    "issued_ts": {
     "type": "TEXT",
     "desc": "发券时间"
    },
    "used_ts": {
     "type": "TEXT",
     "desc": "核销时间；未核销为 NULL"
    },
    "order_id": {
     "type": "TEXT",
     "desc": "核销订单；未核销为 NULL"
    },
    "discount_amt": {
     "type": "REAL",
     "desc": "券面优惠金额"
    },
    "campaign": {
     "type": "TEXT",
     "desc": "活动：new_user/festival/retention"
    }
   }
  }
 },
 "join_keys": [
  "orders.user_id = users.user_id",
  "orders.rider_id = riders.rider_id",
  "orders.merchant_id = merchants.merchant_id",
  "devices.user_id = users.user_id",
  "riders.device_id = devices.device_id",
  "coupons.order_id = orders.order_id",
  "coupons.user_id = users.user_id"
 ],
 "pitfalls": [
  "金额统一为美元等值，不要按本币理解或换算。",
  "时间为 UTC 文本，可直接按字符串比较；跨天判断用 substr(order_ts,1,10)。",
  "一台设备可对应多个账号；统计账号规模必须按 user_id 去重，不能数设备行。",
  "净 GMV = SUM(pay_amt - refund_amt)，不是 SUM(gmv)。",
  "活跃用户按去重 user_id，不是订单数；未送达订单是否计入要看问题口径。",
  "refunded 订单的 refund_amt 等于 pay_amt；cancelled 订单没有退款金额。",
  "coupons.used_ts 为 NULL 表示未核销，不能用 used_ts = '' 判断。",
  "所有数据为合成数据，结论只用于方法演示。"
 ],
 "demo": {
  "note": "演示库裁掉 events 表以控制下载体积；24 道评测题均不依赖该表。其余 6 张表与源库一致。",
