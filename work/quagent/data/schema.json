     "type": "TEXT",
     "desc": "账号 ID，U 开头"
    },
    "city": {
     "type": "TEXT",
     "desc": "注册城市，也是默认下单城市"
    },
    "country": {
     "type": "TEXT",
     "desc": "国家代码：SG/TH/MY/ID/VN/PH"
    },
    "signup_ts": {
     "type": "TEXT",
     "desc": "注册时间，UTC，格式 YYYY-MM-DD HH:MM:SS"
    },
    "user_level": {
     "type": "TEXT",
     "desc": "账号等级：new/normal/vip"
    }
   }
  },
  "devices": {
   "grain": "一行一个“设备-账号”关系；同一设备可对应多个账号",
   "columns": {
    "device_id": {
     "type": "TEXT",
     "desc": "设备 ID，D 开头"
    },
    "user_id": {
     "type": "TEXT",
     "desc": "使用该设备的账号"
    },
    "os": {
     "type": "TEXT",
     "desc": "操作系统：iOS/Android"
    },
    "first_seen_ts": {
     "type": "TEXT",
